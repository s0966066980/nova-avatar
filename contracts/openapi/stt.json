{
  "components": {
    "schemas": {
      "EngineRequest": {
        "properties": {
          "engine": {
            "title": "Engine",
            "type": "string"
          }
        },
        "required": [
          "engine"
        ],
        "title": "EngineRequest",
        "type": "object"
      },
      "Health": {
        "properties": {
          "contract_version": {
            "title": "Contract Version",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "contract_version"
        ],
        "title": "Health",
        "type": "object"
      },
      "TranscribeResult": {
        "properties": {
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Confidence"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Language"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "TranscribeResult",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Nova Avatar STT service",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/engine": {
      "put": {
        "operationId": "set_engine",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EngineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "The engine was switched."
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "The service is up and reports its contract version."
          }
        }
      }
    },
    "/transcribe": {
      "post": {
        "operationId": "transcribe",
        "parameters": [
          {
            "in": "query",
            "name": "language",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscribeResult"
                }
              }
            },
            "description": "The recognized text."
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1"
    }
  ]
}
