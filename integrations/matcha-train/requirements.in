#
# Direct dependencies of the Matcha-TTS training venv (.local/matcha-train/venv).
# torch/torchaudio and matcha-tts itself are installed separately by
# scripts/setup-matcha-train.sh: torch because its wheel index depends on the
# GPU variant, matcha-tts with --no-deps because its metadata pins gradio,
# hydra-optuna-sweeper, jupyter and a dozen other packages training never imports.
# Everything below is what `import matcha.models.matcha_tts` plus our training
# loop need.
torch==2.5.0              # resolution only: installed by the setup script (not emitted)
torchaudio==2.5.0         # resolution only: installed by the setup script (not emitted)
lightning                 # matcha.models.baselightningmodule
einops                    # matcha.models.components.*
diffusers==0.30.3         # 0.41 calls torch.accelerator, missing from torch 2.5.0
huggingface-hub<1         # diffusers 0.30 imports APIs removed in hub 1.x
conformer==0.3.2          # matcha text encoder
hydra-core==1.3.2         # matcha.utils.instantiators (imported at package import)
rich                      # matcha.utils.rich_utils
gdown                     # matcha.utils.utils
wget                      # matcha.utils.utils
matplotlib                # matcha.utils.utils / model plotting
soundfile                 # reading the 16 kHz training wavs
numpy<2                   # torch 2.5.0 wheels are built against numpy 1.x
