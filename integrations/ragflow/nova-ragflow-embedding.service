# Superseded by nova-ragflow-llamacpp-embedding.service (issue 15). Kept only
# for rolling back; see "還原為 GPU Ollama 嵌入" in docs/ragflow.md.

[Unit]
Description=Nova Avatar RAGFlow GPU embedding endpoint

[Service]
Type=simple
WorkingDirectory=%h/nova-avatar
ExecStart=/usr/bin/bash %h/nova-avatar/scripts/ragflow_embedding.sh
Restart=always
RestartSec=5
MemoryMax=4G
CPUQuota=200%
NoNewPrivileges=yes

[Install]
WantedBy=default.target
