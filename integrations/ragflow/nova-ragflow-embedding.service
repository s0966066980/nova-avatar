[Unit]
Description=Nova Avatar RAGFlow GPU embedding endpoint

[Service]
Type=simple
WorkingDirectory=%h/nova-avatar
ExecStart=/usr/bin/bash %h/nova-avatar/scripts/ragflow_embedding.sh
Restart=always
RestartSec=5
MemoryMax=4G
CPUQuota=200%
NoNewPrivileges=yes

[Install]
WantedBy=default.target
