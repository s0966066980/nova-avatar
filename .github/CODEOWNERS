# Map of which code belongs to which processing layer (spec decision 16).
# Later patterns override earlier ones, so the default comes first.

# Default: root configuration, scripts, docs, tests/, and anything not listed below.
* @s0966066980

# Shared types between the core and the layers (nova_contracts).
/contracts/ @s0966066980

# Core: server, routes, turn orchestration, VAD, profiles, config (nova_core).
/core/ @s0966066980

# Avatar rendering layer (nova_render): MuseTalk and the stage scene.
/avatar/ @s0966066980

# Speech-to-text layer (nova_stt).
/services/stt/ @s0966066980

# Answer-model layer (nova_llm): routing, handoff, weather, RAG, web search.
/services/llm/ @s0966066980

# Speech-synthesis layer (nova_tts): engines, voice library, voice training.
/services/tts/ @s0966066980

# Console and stage frontend (consumes the core's HTTP API).
/web/ @s0966066980
